# Copy to .env next to compose.yaml. Never commit .env.

# REQUIRED. JWT signing key, at least 32 bytes. Generate 48 random bytes (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
Jwt__SigningKey=

# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy. With Docker Desktop the
# proxy's requests arrive from the compose network gateway (fixed in compose.yaml).
ForwardedHeaders__KnownProxies__0=172.30.80.1

# Optional overrides (defaults live in appsettings.json).
# Cors__AllowedOrigins__0=https://antryas.github.io
# Cors__AllowedOrigins__1=https://nebula.antrias.site
# RateLimiting__PermitLimit=120
# RateLimiting__WindowSeconds=60
# Demo__ResetInterval=06:00:00

# Optional compose settings: image tag (e.g. sha-1a2b3c4 for a rollback) and loopback host port.
# NEBULA_TAG=latest
# NEBULA_PORT=8080
