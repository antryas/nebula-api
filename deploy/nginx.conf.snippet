# Add inside the existing http { } block (or as a file included from it), then: nginx -t && nginx -s reload
# TLS: issue a certificate for api.antrias.site with the ACME client already used for the other sites
# (win-acme on Windows, or certbot: certbot certonly --webroot -w <webroot> -d api.antrias.site)
# and adjust the certificate paths below.

server {
    listen 80;
    server_name api.antrias.site;

    # Keep ACME HTTP-01 challenges working if the existing setup serves them from a webroot.
    location /.well-known/acme-challenge/ {
        root html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.antrias.site;

    ssl_certificate     C:/certs/api.antrias.site/fullchain.pem;
    ssl_certificate_key C:/certs/api.antrias.site/privkey.pem;

    client_max_body_size 64k;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}
