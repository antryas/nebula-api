{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": ""
  },
  "Demo": {
    "ResetInterval": "06:00:00",
    "ReadOnly": true
  },
  "Jwt": {
    "Issuer": "nebula-api",
    "Audience": "nebula-api",
    "Lifetime": "08:00:00",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://antryas.github.io",
      "https://nebula.antrias.site",
      "http://localhost:4410"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "AiPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Ai": {
    "ApiKey": "",
    "Endpoint": "https://api.deepseek.com",
    "Model": "deepseek-flash",
    "Provider": "DeepSeek",
    "DisableThinking": true,
    "MaxOutputTokens": 600,
    "DailyRequestsPerClient": 20,
    "DailyRequestsTotal": 500,
    "MaxToolIterations": 4,
    "TimeoutSeconds": 20
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
